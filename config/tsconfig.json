{
    "compilerOptions": {
        "target": "es2021",
        "lib": ["es2022", "dom", "dom.iterable", "dom.asynciterable"],
        "moduleResolution": "node",
        "esModuleInterop": true,
        "jsx": "react",

        "strict": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    }
}
